{
  "name": "s3-studio",
  "version": "1.0.0",
  "description": "Developer-focused, Swagger-style viewer for object storage systems (inspired by AWS S3)",
  "main": "apps/explorer-server/dist/index.js",
  "types": "apps/explorer-server/dist/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./apps/explorer-server/dist/index.js",
      "types": "./apps/explorer-server/dist/index.d.ts"
    }
  },
  "files": [
    "apps/explorer-server/dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "pnpm build:server && pnpm build:ui && pnpm copy:ui",
    "build:server": "pnpm --filter explorer-server build",
    "build:ui": "pnpm --filter @object-explorer/ui build",
    "copy:ui": "node scripts/copy-ui-assets.js",
    "clean": "pnpm --filter explorer-server clean && pnpm --filter @object-explorer/ui clean && node -e \"require('fs').rmSync('apps/explorer-server/dist', {recursive: true, force: true})\"",
    "dev": "pnpm --filter explorer-server dev",
    "dev:ui": "pnpm --filter @object-explorer/ui dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "s3",
    "object-storage",
    "storage-explorer",
    "file-browser",
    "storage-viewer",
    "fastify",
    "developer-tools"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.28.0",
  "dependencies": {
    "fastify": "^5.6.2",
    "@fastify/static": "^8.0.0"
  },
  "devDependencies": {
    "prettier": "^3.7.4"
  }
}
